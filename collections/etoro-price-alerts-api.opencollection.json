          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/price-alerts",
            "headers": [
              {
                "name": "x-request-id",
                "value": ""
              },
              {
                "name": "x-api-key",
                "value": ""
              },
              {
                "name": "x-user-key",
                "value": ""
              }
            ]
          },
          "docs": "Returns all active price alerts for the authenticated user."
