        {
          "info": {
            "name": "Create a price alert",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/price-alerts",
            "headers": [
              {
                "name": "x-request-id",
                "value": ""
              },
              {
                "name": "x-api-key",
                "value": ""
              },
              {
                "name": "x-user-key",
                "value": ""
              }
