                "name": "x-request-id",
                "value": ""
              },
              {
                "name": "x-api-key",
                "value": ""
              },
              {
                "name": "x-user-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "alertId",
                "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "type": "path",
                "description": "Unique identifier of the price alert"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates the target price of an existing price alert."
        },
        {
          "info": {
            "name": "Delete a price alert",
