          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/price-alerts/:alertId",
            "headers": [
              {
                "name": "x-request-id",
                "value": ""
              },
              {
                "name": "x-api-key",
                "value": ""
              },
              {
                "name": "x-user-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "alertId",
                "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "type": "path",
                "description": "Unique identifier of the price alert to delete"
              }
            ]
          },
          "docs": "Permanently deletes a price alert owned by the authenticated user."
