          "name": "Upload a media attachment",
          "request": {
            "name": "Upload a media attachment",
            "description": {
              "content": "Two-step media upload: clients first upload a file here to receive an Attachment object, then pass its url in a POST /feeds/post or POST /reactions/.../comment payload. Accepts multipart/form-data with a binary file field. Supported formats: JPEG and PNG. Maximum file size: 8 MB (8,388,608 bytes). The returned url is a plain CDN URL scoped to the uploading user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "attachments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_request_id",
                  "value": "<uuid>",
                  "description": "(Required) Client-generated correlation ID (UUID). Required for request tracing and idempotency."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) A unique request identifier.",
                "key": "x-request-id",
                "value": "<uuid>"
              },
              {
                "disabled": false,
                "description": "(Required) API key for authentication.",
                "key": "x-api-key",
                "value": "<password>"
              },
              {
                "disabled": false,
                "description": "(Required) User-specific authentication key.",
                "key": "x-user-key",
                "value": "<password>"
              },
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "contentType": "image/jpeg, image/png",
                  "description": "(Required) Required. The image file to upload. Supported formats: JPEG and PNG. Maximum size: 8 MB (8,388,608 bytes), enforced server-side."
                }
              ]
            }
