              }
            ],
            "params": [
              {
                "name": "postId",
                "value": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "type": "path",
                "description": "ID of the parent post (UUID)"
              },
              {
                "name": "commentId",
                "value": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
                "type": "path",
                "description": "ID of the comment (UUID)"
              },
              {
                "name": "replyId",
                "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
                "type": "path",
                "description": "ID of the reply (UUID)"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Edits the authenticated user's own reply in-place. Same semantics as updating a comment."
        },
